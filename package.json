{
  "name": "weread-cliper",
  "version": "2.0.0",
  "description": "WeRead Clipper Chrome Extension",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:all": "npm test -- --runInBand && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "dependencies": {
    "tesseract.js": "^6.0.1"
  }
}
